<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_doc_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:text="← পেছনে"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_outline"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="ডকুমেন্ট স্ক্যানার"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_doc_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="0 পেজ"
            android:textColor="#00896C"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Document Preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_doc_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Document Preview" />

        <TextView
            android:id="@+id/tv_doc_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="ক্যামেরায় ছবি তুলুন অথবা গ্যালারি থেকে বেছে নিন"
            android:textColor="#64748B"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Clean Uncrowded Controls (2 balanced capture/edit rows + filters + export) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:elevation="4dp">

        <!-- Capture & Page Navigation Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_camera"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="📷 ক্যামেরা"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_gallery"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="🖼️ গ্যালারি"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="◀"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="▶"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_del_page"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_outline"
                android:text="🗑️"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Edit, Book Split, Smart Eraser & OCR Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_autocrop"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="✂️ ক্রপ"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_book_split"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.15"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="📖 বুক স্প্লিট"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_eraser"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="🧹 ইরেজার"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_rotate"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.85"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="↻ ৯০°"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_ocr"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_outline"
                android:text="🔤 OCR"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- All 6 Signature Filters Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_orig"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="আসল"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_magic"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.15"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip"
                android:text="ম্যাজিক"
                android:textAllCaps="false"
                android:textColor="#00896C"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_bw"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="B&amp;W"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_bw2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="B&amp;W2"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_gray"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline"
                android:text="গ্রে"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_filter_light"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_outline"
                android:text="উজ্জ্বল"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Export Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_save_pdf"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.25"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_primary"
                android:text="📄 PDF সেভ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_long_img"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_outline"
                android:text="🖼️ লং ইমেজ"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_doc_print"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_outline"
                android:text="🖨️ প্রিন্ট"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
