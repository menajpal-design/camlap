<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:text="← পেছনে"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_outline"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="🔍 OCR টেক্সট এক্সট্র্যাক্টর"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ocr_word_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 শব্দ"
            android:textColor="#00896C"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Import Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_camera"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📷 ক্যামেরা"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_btn_outline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_gallery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🖼️ গ্যালারি"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_btn_outline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_run"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🔍 OCR চালান"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/pb_ocr"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:visibility="gone"
        android:indeterminate="true"
        android:progressTint="#00896C" />

    <TextView
        android:id="@+id/tv_ocr_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="ছবি নিন বা গ্যালারি থেকে ইমপোর্ট করুন"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Split: Preview + Result -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Image Preview (left half) -->
        <ImageView
            android:id="@+id/iv_ocr_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_card"
            android:padding="4dp"
            android:contentDescription="OCR Source Image" />

        <!-- OCR Result (right half) -->
        <EditText
            android:id="@+id/et_ocr_result"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="OCR টেক্সট এখানে দেখাবে…"
            android:gravity="top|start"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:verticalScrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:inputType="textMultiLine"
            android:imeOptions="flagNoEnterAction" />
    </LinearLayout>

    <!-- Search in result -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/et_ocr_search"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:hint="টেক্সটে খুঁজুন..."
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_highlight"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="10dp"
            android:text="🔍"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#00896C"
            android:background="@drawable/bg_btn_outline" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:elevation="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_copy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📋 কপি"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_save_txt"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="💾 TXT"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_btn_outline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_save_pdf"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📄 PDF"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="@drawable/bg_btn_outline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ocr_clear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🗑️"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#EF4444"
            android:background="@drawable/bg_btn_outline" />
    </LinearLayout>
</LinearLayout>
