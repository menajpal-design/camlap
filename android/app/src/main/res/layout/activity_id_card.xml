<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:elevation="2dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_id_back"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="12dp"
                android:text="← পেছনে"
                android:textAllCaps="false"
                android:background="@drawable/bg_btn_outline"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="💳 আইডি কার্ড (২-সাইড)"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Front Card Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_id_front_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 সামনের দিক (Front)"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_id_front"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="fitCenter"
                android:background="#F1F5F9"
                android:layout_marginTop="8dp"
                android:contentDescription="Front" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_front_camera"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📷 ক্যামেরা"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_front_gallery"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🖼️ গ্যালারি"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_autocrop_front"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✂️ অটো ক্রপ"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#00896C"
                    android:background="@drawable/bg_btn_outline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Back Card Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_id_back_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 পেছনের দিক (Back)"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_id_back"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="fitCenter"
                android:background="#F1F5F9"
                android:layout_marginTop="8dp"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_back_camera"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📷 ক্যামেরা"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_back_gallery"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🖼️ গ্যালারি"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_autocrop_back"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✂️ অটো ক্রপ"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#00896C"
                    android:background="@drawable/bg_btn_outline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sheet Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📄 A4 শিট প্রিভিউ"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_generate_sheet"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="12dp"
                    android:text="🔄 রিফ্রেশ"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#00896C"
                    android:background="@drawable/bg_chip" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_id_sheet_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A4 প্রিভিউ — ছবি যোগ করলে এখানে দেখাবে"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/iv_id_sheet"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="fitCenter"
                android:background="#F1F5F9"
                android:contentDescription="Sheet Preview" />
        </LinearLayout>

        <!-- Export Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="24dp"
>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_id_save_pdf"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📄 A4 PDF সংরক্ষণ করুন"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_save_img"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="🖼️ JPG সংরক্ষণ"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_id_print"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🖨️ প্রিন্ট করুন"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:background="@drawable/bg_btn_outline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
