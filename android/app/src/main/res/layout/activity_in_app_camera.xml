<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Live CameraX Preview inside camlab -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scanner Frame Guide Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="28dp"
        android:paddingTop="86dp"
        android:paddingBottom="136dp">

        <View
            android:id="@+id/view_scan_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_btn_outline"
            android:alpha="0.45" />
    </FrameLayout>

    <!-- Top Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B30F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cam_close"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="12dp"
            android:text="← বন্ধ"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_cam_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📷 camlab স্ক্যানার"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cam_grid"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="10dp"
            android:text="⊞ গ্রিড"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cam_flash"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:text="⚡ অটো"
            android:textAllCaps="false"
            android:textColor="#00896C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Guide Hint Pill -->
    <TextView
        android:id="@+id/tv_cam_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="#CC0F172A"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="ডকুমেন্ট ফ্রেমের ভেতর রাখুন"
        android:textColor="#ECFDF5"
        android:textSize="12sp" />

    <!-- Bottom Capture Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cam_switch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="14dp"
            android:text="🔄 ক্যামেরা"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cam_shutter"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="📸 ছবি তুলুন / স্ক্যান করুন"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>

